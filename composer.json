{
    "name": "reactphp-x/web-ssh",
    "description": "Web SSH terminal via websocket-group, xterm.js, and OpenSSH.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-sqlite3": "*",
        "react/child-process": "^0.6.7",
        "reactphp-x/framework": "dev-master",
        "reactphp-x/websocket-group": "^1.0",
        "wpjscc/twofactorauth": "^3.1",
        "bacon/bacon-qr-code": "^3.1",
        "reactphp-x/log": "dev-master",
        "reactphp-x/redis-pool": "^2.0",
        "react/async": "^4.3",
        "neuron-core/neuron-ai": "^3.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "config/log.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
