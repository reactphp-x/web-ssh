APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

HTTP_LISTEN=0.0.0.0:8095
HTTP_WORKERS=1

FILE_MONITOR_INTERVAL=1

# SQLite (clue/reactphp-sqlite)
DB_PATH=storage/web_ssh.sqlite
DB_AUTO_MIGRATE=true

# Optional default SSH private key fallback
SSH_IDENTITY_FILE=/root/.ssh/id_rsa

# TCP/SSH connect timeout in seconds (default 10)
SSH_CONNECT_TIMEOUT=10

# Optional comma-separated RPC tokens for websocket-group HTTP API
WS_RPC_TOKENS=

# Logging
LOG_CHANNEL=stdout
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log
DB_LOG_PATH=storage/logs/database.log
DB_LOG_LEVEL=debug
LOG_ROTATION_MAX_FILES=14
LOG_ROTATION_INTERVAL=3600
HTTP_ACCESS_LOG=storage/logs/access.log

# HTTPS 部署时设为 true，为 2FA Cookie 添加 Secure 标志
COOKIE_SECURE=false

# HTTP Basic Auth (leave BASIC_AUTH_USER empty to disable)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me
BASIC_AUTH_REALM="Web SSH"
BASIC_AUTH_PUBLIC_PATHS=/health,/logout,/login
