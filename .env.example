APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

HTTP_LISTEN=0.0.0.0:8095
HTTP_WORKERS=1

FILE_MONITOR_INTERVAL=1

# SQLite (clue/reactphp-sqlite)
DB_PATH=storage/web_ssh.sqlite
DB_AUTO_MIGRATE=true

# SSH session recording (asciinema cast files under storage/recordings/)
SESSION_RECORDING_ENABLED=true
SESSION_RECORDING_DIR=storage/recordings
SESSION_RECORDING_PART_BYTES=5242880

# Optional default SSH private key fallback
SSH_IDENTITY_FILE=/root/.ssh/id_rsa

# TCP/SSH connect timeout in seconds (default 10)
SSH_CONNECT_TIMEOUT=10

# Optional comma-separated RPC tokens for websocket-group HTTP API
WS_RPC_TOKENS=

# Logging
LOG_CHANNEL=stdout
LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log
DB_LOG_PATH=storage/logs/database.log
DB_LOG_LEVEL=debug
LOG_ROTATION_MAX_FILES=14
LOG_ROTATION_INTERVAL=3600
HTTP_ACCESS_LOG=storage/logs/access.log

# HTTPS 部署时设为 true，为 2FA Cookie 添加 Secure 标志
COOKIE_SECURE=false

# HTTP Basic Auth (leave BASIC_AUTH_USER empty to disable)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me
BASIC_AUTH_REALM="Web SSH"
BASIC_AUTH_PUBLIC_PATHS=/health,/logout,/login

# Neuron AI assistant (embedded in terminal page)
AI_ENABLED=true
# Allow clearing chat history inside an AI orchestration session (default: false)
AI_SESSION_RESET_ENABLED=false
NEURON_AI_KEY=
NEURON_AI_MODEL=gpt-4o-mini
NEURON_AI_PROVIDER=openai
# NEURON_AI_BASE_URL=https://api.deepseek.com/v1
NEURON_AI_HTTP_TIMEOUT=120
NEURON_WORKFLOW_PERSISTENCE=file
AI_COMMAND_TIMEOUT=30
# Max run_ssh_command (and other tool) invocations per chat thread (default 30, was 10)
NEURON_AI_TOOL_MAX_RUNS=30

# Chat context: hard trim cap (tokens) and optional LLM summarization before hitting it
NEURON_CHAT_CONTEXT_WINDOW=50000
NEURON_CHAT_SUMMARIZATION_ENABLED=true
# Default: 80% of NEURON_CHAT_CONTEXT_WINDOW (40000 when window is 50000)
# NEURON_CHAT_SUMMARIZATION_MAX_TOKENS=40000
NEURON_CHAT_SUMMARIZATION_KEEP=5

# Redis for AI thread locks / SSE state (optional when HTTP_WORKERS=1)
REDIS_URL=127.0.0.1:6379
